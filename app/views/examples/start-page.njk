{% extends "layout.njk" %}

{% block content %}
  <section class="kcl-section kcl-section--intro">
    <div class="kcl-width-container kcl-reading-width">
      <p class="kcl-label">Example journey</p>
      <h1>Apply for a programme</h1>
      <p class="kcl-lede">Use this page as a starting point for a service introduction or task start page.</p>
      <a class="kcl-button" href="/examples/programme-details">Start now</a>
    </div>
  </section>

  <section class="kcl-section">
    <div class="kcl-width-container kcl-grid kcl-grid--two">
      <div>
        <h2>Before you start</h2>
        <p>You can use this pattern to explain eligibility, documents needed and what happens next.</p>
      </div>
      <div class="kcl-note">
        <h2>Prototype note</h2>
        <p>Replace this content with the task, audience and evidence for the thing you are testing.</p>
      </div>
    </div>
  </section>
{% endblock %}
